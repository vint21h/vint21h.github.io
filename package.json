{
  "name": "vint21h.github.io",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.34.1",
    "@typescript-eslint/parser": "8.34.1",
    "eslint": "9.29.0"
